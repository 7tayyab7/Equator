{
  "name": "equator-hydrogen",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 3000",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "react-router build && vite preview",
    "deploy:preview": "shopify hydrogen deploy --preview --assets-dir build/client --worker-dir build/server",
    "deploy:client-preview": "shopify hydrogen deploy --env client-preview --assets-dir build/client --worker-dir build/server"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "@shopify/hydrogen": "2026.10.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@shopify/cli": "^4.9.4",
    "@shopify/mini-oxygen": "^4.2.3",
    "@shopify/oxygen-workers-types": "^4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
