{
  "name": "equator-hydrogen",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "health:check": "node scripts/storefront-health.mjs",
    "dev": "react-router dev --host 127.0.0.1 --port 3000",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "react-router build && vite preview",
    "deploy:preview": "shopify hydrogen deploy --preview",
    "deploy:client-preview": "shopify hydrogen deploy --env client-preview",
    "deploy:production": "shopify hydrogen deploy --env production"
  },
  "dependencies": {
    "@fontsource/roboto-condensed": "^5.3.0",
    "@shopify/hydrogen": "2026.10.3",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0",
    "ipaddr.js": "2.5.0",
    "isbot": "^5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@shopify/cli": "4.9.5",
    "@shopify/mini-oxygen": "4.3.0",
    "@shopify/oxygen-workers-types": "^4.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "@shopify/mini-oxygen": {
      "body-parser": "1.20.9"
    },
    "miniflare": {
      "undici": "7.30.1",
      "sharp": "0.35.5"
    },
    "qs": "6.17.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
