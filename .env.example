# Copy to .env after connecting the separate Hydrogen preview storefront.
# Use the exact myshopify.com domain shown by Shopify; do not commit .env.
# PUBLIC_STORE_DOMAIN=your-store.myshopify.com
# Public Storefront token needs unauthenticated_read_metaobjects.
# PUBLIC_STOREFRONT_API_TOKEN=
# No Admin API or private Storefront token is needed by the homepage reader.

# Enable only after approved launch on https://equatorstores.com. Preview hosts remain disabled.
SEO_INDEXING_ENABLED=false
TRACKING_ENABLED=false
PK_ONLY_ENABLED=false
PK_ONLY_ALLOW_SEARCH_BOTS=false

# No longer used: Shopify checkout/account/form links always use equatorstores.myshopify.com (app/lib/hosted-store.ts).
PUBLIC_CHECKOUT_DOMAIN=checkout.equatorstores.com

